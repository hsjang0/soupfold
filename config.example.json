{
  "af3": {
    "python": "/path/to/alphafold3_venv/bin/python",
    "pythonpath": ["/path/to/alphafold3", "/path/to/alphafold3/src"],
    "env": {"XLA_PYTHON_CLIENT_PREALLOCATE": "false"},
    "args": ["--model-dir", "/path/to/af3_params"]
  },
  "protenix": {
    "python": "/path/to/protenix_env/bin/python",
    "env": {"PROTENIX_ROOT_DIR": "/path/to/protenix_root", "LAYERNORM_TYPE": "torch"}
  },
  "opendde": {
    "python": "/path/to/opendde_env/bin/python",
    "env": {"PROTENIX_ROOT_DIR": "/path/to/protenix_root", "LAYERNORM_TYPE": "torch"},
    "args": ["--checkpoint", "/path/to/opendde.pt"]
  },
  "esmfold2": {
    "python": "/path/to/esmfold2_env/bin/python",
    "args": ["--ckpt", "/path/to/esmfold2", "--esmc", "/path/to/esmc-6b"]
  },
  "template_mmcif_dir": "./examples/9mnb/mmcif",
  "release_dates": "/path/to/protenix_root/common/release_date_cache.json",
  "obsolete_pdbs": "/path/to/protenix_root/common/obsolete_to_successor.json",
  "kalign": "/path/to/kalign"
}
