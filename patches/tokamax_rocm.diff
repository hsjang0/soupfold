+# tokamax's global gate answers False on ROCm (it parses compute_capability as a float),
+# and it must stay that way: normalization and gated_linear_unit consult the same gate and
+# their Triton kernels do not fit in 64 KiB of LDS, so flipping it globally breaks AF3
+# everywhere. Attention is opted in on its own, and only when asked for explicitly.
+_ROCM_TRITON_TARGETS = frozenset(('gfx90a', 'gfx940', 'gfx941', 'gfx942', 'gfx950'))
+
+
+def _attention_triton_supported(device=None) -> bool:
+  if triton_lib.has_triton_support(device):
+    return True
+  if os.environ.get('TOKAMAX_ROCM_ATTENTION_TRITON', '') not in ('1', 'true', 'True'):
+    return False
+  if device is None:
+    device = jax.extend.backend.get_default_device()
+  return getattr(device, 'compute_capability', None) in _ROCM_TRITON_TARGETS
+
